# Weekly restore drill, Sunday mornings before the working day starts.
# Randomized by up to 30 minutes so several schools are not simultaneous.

[Unit]
Description=Run the SMILE restore drill weekly
Documentation=file:/opt/smile/docs/SECURITY.md

[Timer]
OnCalendar=Sun *-*-* 05:30:00
RandomizedDelaySec=1800
Persistent=true
Unit=smile-restore-drill.service

[Install]
WantedBy=timers.target