# Configuration for the SMILE encrypted backup job.
#
# Install:
#   sudo install -o root -g smile -m 0640 backup.env /etc/smile/backup.env
#   sudo systemctl restart smile-backup.timer
#
# This file is read by systemd as EnvironmentFile. It must NOT be world
# readable: it carries the database password.

# --- database ---------------------------------------------------------------
# Use a DEDICATED role for backups, not the application role, so a leak of this
# file does not grant write access to pupil records.
#
# On the database:
#   CREATE ROLE smile_backup LOGIN PASSWORD '<generate>';
#   GRANT CONNECT ON DATABASE smile_db TO smile_backup;
#   GRANT USAGE ON SCHEMA public TO smile_backup;
#   GRANT SELECT ON ALL TABLES IN SCHEMA public TO smile_backup;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public
#     GRANT SELECT ON TABLES TO smile_backup;
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_NAME="smile_db"
DB_USER="smile_backup"
PGPASSWORD="CHANGE_ME"

# Alternative to PGPASSWORD above, and better if you can manage it:
#   install -o root -g smile -m 0640 /dev/null /home/smile/.pgpass
#   and put "127.0.0.1:5432:smile_db:smile_backup:<password>" in it.
# Then comment out PGPASSWORD above.

# --- remote -----------------------------------------------------------------
# The crypt remote created by setup-gdrive-backup.sh. This must be the ENCRYPTED
# remote, never the bare Drive remote: using the bare one would upload plaintext.
CRYPT_REMOTE="gdrive-crypt"

# --- encryption --------------------------------------------------------------
# The backup encryption key. This is an INDEPENDENT secret.
#
# It must NOT be the Microsoft account password. Deriving the key from the
# password meant that rotating the password silently made every backup already
# in the cloud permanently unreadable, and the server-side restore path could
# not find the key the backup path had used. Keep them separate.
BACKUP_ENCRYPTION_PASSPHRASE="CHANGE_ME"

# Without this the backup refuses to run rather than encrypting pupil data with
# a weak or recycled key. Verify with:  python3 backup_m365.py --check

# --- Microsoft 365 (backup_m365.py) -----------------------------------------
# Used ONLY for the /me/drive Graph calls. The database DSN comes from
# DATABASE_URL above or from the DB_* variables.
M365_USER="smile@ms-telfs.at"
M365_PASSWORD="CHANGE_ME"     # ideally unset; see setup-m365-rclone.sh

# --- retention (backup_m365.py) ---------------------------------------------
# Local: 10-minute snapshots kept KEEP_INTRADAY_DAYS, 19:00 dailies KEEP_DAILY_DAYS.
KEEP_INTRADAY_DAYS="3"
KEEP_DAILY_DAYS="30"

# Cloud: timestamped intraday folders are deleted once older than this.
# At 78 runs/day this is the main lever on OneDrive storage cost.
#
# SIZE WARNING: 78 runs/day x 30 days = ~2340 folders, each holding one
# encrypted dump plus three encrypted reports (~30 MB dump). That is roughly
# 70-100 GB. School M365 accounts commonly have 1-5 GB. Check
#   sudo -u smile du -sh /var/backups/smile/smile_db_*.dump | tail -1
# for the real per-run size, then start at 7 and raise this once the quota is
# confirmed.
CLOUD_KEEP_DAYS="7"

BACKUP_PREFIX="smile"
DUMP_TIMEOUT="1800"
RCLONE_TIMEOUT="900"

# --- retention --------------------------------------------------------------
# Hourly detail for 3 days, then one per day, one per week, one per month.
# At roughly 30 MB per compressed dump this keeps about 3-4 GB on Drive.
KEEP_HOURS_DAYS="3"
KEEP_DAILY_DAYS="31"
KEEP_WEEKLY_WEEKS="16"