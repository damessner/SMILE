{
	admin localhost:2019
	# HTTP redirects are declared explicitly below.
	auto_https disable_redirects
}

# Internal-only HTTPS. Caddy's local CA issues certificates for both names.
https://172.16.1.11, https://smile.schule.intern {
	tls internal

	encode zstd gzip

	# Caddy forwards X-Forwarded-Proto/Host itself; adding header_up here
	# duplicates the defaults and produces misleading warnings.
	reverse_proxy 127.0.0.1:3000

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy same-origin
	}
}

http://172.16.1.11, http://smile.schule.intern {
	redir https://{host}{uri} permanent
}
