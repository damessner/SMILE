# Copy to .env for local development. Never commit .env.
#
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# DATABASE_URL must point at the school database. There is deliberately no
# fallback value: the server refuses to start without it.
DATABASE_URL="postgres://smile_user:CHANGE_ME@127.0.0.1:5432/smile_db"

# At least 32 characters; must not be a value that was ever committed.
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_VALUE_AT_LEAST_32_CHARS"

# One-time first-login password for newly seeded accounts. Minimum 12 chars.
INITIAL_USER_PASSWORD="CHANGE_ME_START_PASSWORD"
# Optional; if set, used for the 'admin' account at first seed.
ADMIN_PASSWORD=""

# Optional admin/backup settings
BACKUP_DIR="/var/backups/smile"
BACKUP_ENCRYPTION_PASSPHRASE=""

# HTTP / deployment
PORT=3000
HOST="0.0.0.0"
NODE_ENV="development"
# Set to true only behind a TLS-terminating proxy, and set TRUST_PROXY too.
COOKIE_SECURE="false"
TRUST_PROXY="false"
RUN_MIGRATIONS="true"

# Same-origin only by default. Add split-origin dev clients here.
CORS_ALLOWED_ORIGINS=""

# Session and rate limits
SESSION_TTL_SECONDS=28800
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
GLOBAL_RATE_LIMIT_MAX=600
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
WS_RATE_LIMIT_PER_SECOND=10
WS_RATE_LIMIT_BURST=40
BODY_LIMIT_BYTES=262144
WS_ROOM_MAX_CLIENTS=200
WS_SOFT_LOCK_TTL_MS=5000

# Assessment window (ISO-8601, explicit timezone)
SUBMISSION_DEADLINE="2026-10-30T21:59:59.000Z"
OFFICIAL_CONFERENCE_DATE="2026-11-03T21:59:00.000Z"
RANK_AGGREGATION="total"
RANK_THRESHOLD_MEISTER=14
RANK_THRESHOLD_GESELLE=8
RUBRIC_ITEM_COUNT=18
YELLOW_CARD_ALERT_THRESHOLD=2
YELLOW_CARD_ALERT_WINDOW_DAYS=7
YELLOW_CARD_RANK_LOSS_THRESHOLD=3
ESCALATION_STEP=3
# How many calendar days back a Time-Out may be recorded.
RETROACTIVE_TIMEOUT_MAX_DAYS=7

# Privacy / statistics policy
STATISTICS_SCHOOL_WIDE=true
STATISTICS_SHOW_FOREIGN_COMMENTS=true

# Microsoft Teams staff-channel notifications
# Create a Teams Workflow ("Send webhook alerts to a channel") and paste its
# URL here. The URL is a bearer secret: keep it in .env, never commit it.
# Leave empty to disable sending without changing code.
TEAMS_WEBHOOK_URL=""
TEAMS_NOTIFICATIONS_ENABLED=true
# Used for the card's "In SMILE öffnen" link.
PUBLIC_APP_URL="https://172.16.1.11"

# SMTP e-mail notifications (alternative to the Teams webhook)
# For Microsoft 365: smtp.office365.com, port 587, SMTP_SECURE=false.
# NOTIFICATION_EMAIL_TO may be a staff distribution list or the e-mail address
# of a Teams channel (channel -> ... -> "Get email address"). Comma-separated.
EMAIL_NOTIFICATIONS_ENABLED=true
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
NOTIFICATION_EMAIL_TO=""
# MED/SLC always receive 3/6/9 time-out escalation mails. Comma-separated.
LEADERSHIP_NOTIFICATION_EMAILS=""

# --- WebUntis ---------------------------------------------------------------
# All settings are optional: SMILE starts without WebUntis and simply reports
# the integration as disconnected. Teacher-specific accounts are linked from
# the UI and stored encrypted.
#
# Deployment environment. Playground is for training only; never point a live
# class at it. This is not switchable at runtime.
WEBUNTIS_ENV="production"
WEBUNTIS_SERVER="ms-telfs.webuntis.com"
WEBUNTIS_SCHOOL="ms-telfs"
# Optional override for the training school id (defaults to the MS-Telfs playground).
WEBUNTIS_PLAYGROUND_SCHOOL="PG6ef0f7d3-abdf-49b5-ab74-044ef932d877"
# Shared read-only leadership account. There is no built-in password and the
# account is never used as a fallback for teachers. Leave WEBUNTIS_PASSWORD
# empty to disable it.
WEBUNTIS_USER="untis_monitor"
WEBUNTIS_PASSWORD=""
# Dedicated encryption key for stored WebUntis passwords (min. 32 chars).
# If unset, a key derived from JWT_SECRET is used; rotating JWT_SECRET then
# makes stored WebUntis credentials unreadable. Generate a separate value.
WEBUNTIS_CREDENTIAL_KEY=""
# Comma-separated allowlist for the host a teacher may connect to. Exact host or
# subdomain suffix; prevents the connect endpoint from being used as an SSRF probe.
WEBUNTIS_ALLOWED_HOSTS="webuntis.com"
# Outbound request timeout in milliseconds.
WEBUNTIS_TIMEOUT_MS=10000
# Mirror SMILE cards/time-outs into the WebUntis class register.
WEBUNTIS_AUTO_SYNC_DISCIPLINARY=true
# Durable retry queue for class-register mirrors.
WEBUNTIS_SYNC_INTERVAL_MS=30000
WEBUNTIS_SYNC_MAX_ATTEMPTS=8
# Stop retrying entries older than seven days and mark them failed.
WEBUNTIS_SYNC_MAX_AGE_MS=604800000
