# ---------------------------------------------------------------------------
# SMILE server configuration
#
# Copy to `.env` at the repository root and fill in real values:
#   cp .env.example .env
#
# `.env` must never be committed. There is no .gitignore in this repository yet —
# see docs/SECURITY.md, item "Version control".
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Create a dedicated, least-privilege role. Never reuse the postgres superuser.
#   CREATE ROLE smile_user LOGIN PASSWORD '<generate a new one>';
#   CREATE DATABASE smile_db OWNER smile_user;
DATABASE_URL="postgres://smile_user:CHANGE_ME@127.0.0.1:5432/smile_db"

# --- Session signing --------------------------------------------------------
# Generate a fresh 48-byte secret. The server refuses to start if this is missing,
# shorter than 32 characters, or matches a value that was previously leaked:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME_generate_with_the_command_above"

# --- Server -----------------------------------------------------------------
PORT=3000
HOST="0.0.0.0"
NODE_ENV="production"

# Set to true ONLY when a reverse proxy you control terminates TLS and sets
# X-Forwarded-* headers. Leaving it true without such a proxy lets clients spoof
# their IP and defeat rate limiting.
TRUST_PROXY=false
# Set to true when the app is served over HTTPS, so session cookies carry the Secure flag.
COOKIE_SECURE=false

# --- CORS -------------------------------------------------------------------
# Empty means same-origin only, which is correct for the default deployment since
# the server hosts the client bundle itself.
# For the Vite dev server on a different port, set:
#   CORS_ALLOWED_ORIGINS="http://localhost:5173"
CORS_ALLOWED_ORIGINS=""

# --- Session lifetime -------------------------------------------------------
SESSION_TTL_SECONDS=28800
SESSION_GRACE_SECONDS=60

# --- Rate limiting ----------------------------------------------------------
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
GLOBAL_RATE_LIMIT_MAX=600
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
BODY_LIMIT_BYTES=262144

# --- WebSocket --------------------------------------------------------------
WS_ROOM_MAX_CLIENTS=200
WS_SOFT_LOCK_TTL_MS=5000

# --- Bootstrap passwords (used only by `npm run seed`) ----------------------
# First-login password for newly created accounts. Every account is flagged
# must_change_password and cannot write anything until it is changed.
# The old shared default "smile2026" (all teachers) and "admin123" (admin) are
# banned and will be rejected.
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
INITIAL_USER_PASSWORD="CHANGE_ME_generate_with_the_command_above"

# Optional: a distinct password for the single admin account.
# If unset, the admin is created with INITIAL_USER_PASSWORD.
# Re-running the seed never overwrites an existing admin password.
ADMIN_PASSWORD=""

# --- Business deadlines -----------------------------------------------------
# RFC3339 / ISO-8601. Previously hardcoded in route handlers, which silently
# rejected all submissions after the date with no way to override.
SUBMISSION_DEADLINE="2026-10-30T21:59:59.000Z"
OFFICIAL_CONFERENCE_DATE="2026-11-03T21:59:59.000Z"

# --- Assessment -------------------------------------------------------------
# Rank thresholds over the 18-item Beobachtungsraster.
RUBRIC_ITEM_COUNT=18
RANK_THRESHOLD_MEISTER=14
RANK_THRESHOLD_GESELLE=8

# total      = count every positive item across all of a pupil's evaluations
#              (historical behaviour; the total grows with the number of
#               co-teachers rating the pupil)
# normalized = rescale each evaluation to an 18-item raster before averaging, so
#              "14" always means 14 of 18 regardless of co-teacher count
RANK_AGGREGATION="total"

# --- Escalation rules -------------------------------------------------------
YELLOW_CARD_ALERT_THRESHOLD=2
YELLOW_CARD_ALERT_WINDOW_DAYS=7
ESCALATION_STEP=3