# ==============================================================================
# .gitignore — SMILE Platform
#
# Sensitive school data (pupil names, teacher rosters, grades, credentials, dumps)
# MUST NEVER be committed to version control.
# ==============================================================================

# Environment and Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Sensitive School Data & Untis Exports
export/*
!export/README.md
!export/.gitkeep
Stundenplan.TXT
Unterricht.TXT
*.TXT
*.csv
*.tsv
*.dump
*.sql.gz
export/*.sql

# Allow Drizzle schema migration SQL files
!server/drizzle/*.sql
!server/drizzle/**/*.sql

# Legacy extraction scripts containing embedded WebUntis credentials
webuntis-login.ps1
webuntis-session.ps1
export-teacher-classes.ps1
Beobachtungsraster_Lehrling_Geselle_Meister_Vorschlag1.docx

# Backups and archives (contain complete pupil database dumps)
backup_*
*.zip
*.tar.gz
*.tgz
tools/
m365_rclone.conf
m365_token.txt
*.xlsx


# Third-party clones & scratch scripts
UntisPlus-main/
scratch/
_*.mjs
_*.js

# Dependencies
node_modules/

# Build output
client/dist/
server/dist/
*.tsbuildinfo

# Logs and Python cache
*.log
npm-debug.log*
__pycache__/
*.py[cod]

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Test artifacts
coverage/
# Superpowers SDD workspaces (ledger, briefs, review packages)
.superpowers/
